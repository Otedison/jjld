# MongoDB Configuration
# Copy this file to .env and update with your test database connection string

# Database Connection - Update with your test database URI
# For local MongoDB: mongodb://jukwaa_admin:change_me@127.0.0.1:27017/jukwaa_hub?authSource=admin
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jukwaa_hub
MONGO_URI=mongodb://jukwaa_admin:change_me@127.0.0.1:27017/jukwaa_hub?authSource=admin

# Server Configuration
PORT=5000

# Frontend Origins (comma-separated)
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173

# Allow API to start without DB (for development)
ALLOW_START_WITHOUT_DB=true

# MongoDB Connection Timeouts (optional)
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=30000

